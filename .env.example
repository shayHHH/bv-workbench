# ===== 复制为 .env 使用；真实 .env 不入库 =====

# API 服务端口
PORT=3000

# 业务主库（本地开发用 docker compose 起的 Mongo）
MONGODB_URI=mongodb://127.0.0.1:27017/bv_workbench

# JWT 签名密钥（生产必须改为强随机值，如 openssl rand -hex 32 的输出）
JWT_SECRET=bv-workbench-dev-secret-change-me

# ---- 准入材料文件存储 ----
# 本地磁盘适配器的存储目录；相对路径基于 apps/api 工作目录，生产用 Docker volume 挂载。
# 公司对象存储（S3 兼容）信息确认后将新增 STORAGE_DRIVER/S3_* 配置并切换适配器。
UPLOAD_DIR=uploads

# ---- 内部数据仓库（预留，暂不启用）----
# 后续接入公司内部数仓时填写；留空则不注册该连接。
# 接入前需确认：独立数据库账号（最小权限）、服务器出口 IP 白名单、是否要求 TLS。
INTERNAL_DW_MONGODB_URI=

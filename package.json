{
  "name": "bv-workbench",
  "private": true,
  "version": "0.1.0",
  "description": "Bitvast Trade Workbench —— 交易运营系统（Node + MongoDB + Vue3）",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm run build -w @bv/shared",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run start:dev -w @bv/api",
    "dev:web": "npm run dev -w @bv/web",
    "build": "npm run build -w @bv/shared && npm run build -w @bv/api && npm run build -w @bv/web",
    "seed": "node scripts/seed.mjs",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
